set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

default:
    just --list

# Parse the shared build program and type-check every compatibility entry.
build-scripts-check:
    node --check backend/package/build.mjs
    node --test backend/package/resources.test.mjs
    node --check scripts/release.mjs
    node --test scripts/release.test.mjs
    moon check backend/package/internal/cli backend/package/macos backend/package/windows backend/package/linux backend/package/browser backend/package/dev --target native

# Build the current host's debug package through the backend module.
package:
    {{ if os() == "macos" { "moon run backend/package/macos --target native -- --no-open" } else if os() == "linux" { "moon run backend/package/linux --target native" } else { "moon run backend/package/windows --target native" } }}

# Build and launch the unbundled native host with proton_cli dev.
dev:
    moon run backend/package/dev --target native

# Build the Desktop browser application and run Playwright.
test-browser:
    moon run backend/package/browser --target native
    {{ if os() == "windows" { "npm.cmd" } else { "npm" } }} --prefix e2e test
